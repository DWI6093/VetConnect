# Base de datos
# Neon pooled connection string for the running API
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/appdb?sslmode=require
# Neon direct connection string for Prisma migrations
DIRECT_DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/appdb?sslmode=require

# NestJS
NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-in-development
REFRESH_SECRET=change-me-in-development

# URLs y cookies
FRONTEND_URL=http://localhost:4200,https://localhost:4200
COOKIE_SAME_SITE=lax
API_URL=http://localhost:3000
